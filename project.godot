; Engine configuration file.
; Projet TRACE — phase 1 « Le geste » (îlot gris, marche + skate).

config_version=5

[application]

config/name="TRACE"
config/description="Phase 1 — îlot gris, locomotion pied + skate, 4 tricks, 3 obstacles."
run/main_scene="res://scenes/ilot_grey.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

InputSetup="*res://scripts/input_setup.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
