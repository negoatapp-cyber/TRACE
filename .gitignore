# Godot 4
.godot/
/android/
# export_presets.cfg (gardé : seulement le préréglage Web, sans secret)
*.tmp

# Moteur et outils de validation locaux
.tools/*
!.tools/verify_phase1.gd
!.tools/verify_quartier.gd
!.tools/verify_graffiti.gd
!.tools/verify_grimpe.gd
