# Fichiers locaux à ne jamais publier (dépôt public)
*.mp4
*.zip
*.pdf
/*.png
/*.jpg
/*.jpeg
/*.png.import

# Modèles 3D des personnages (licence Meshy privée) : gardés en local, jamais dans le dépôt public
assets/personnages/*
!assets/personnages/LISEZMOI.md
# Le lettrage de Loums (photos de Louma) : local seulement
assets/graffitis/*
!assets/graffitis/LISEZMOI.md

# Dossier perso (photos, vidéos avec des vraies personnes) : jamais dans le dépôt
trace/
!.tools/lettrage_refs.py

# fichiers à jeter (en attente de suppression sur le PC)
_to_delete/
_sauvegardes/

# sons fabriqués par .tools/son_generer.py (n°3) : régénérés, pas suivis
assets/sons/*.wav
assets/sons/*.wav.import
